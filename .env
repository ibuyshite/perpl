PERPL_API_URL=https://app.perpl.xyz/api
PERPL_WS_URL=wss://app.perpl.xyz
PERPL_CHAIN_ID=143

# Mainnet BTC market id is 1.
PERPL_MARKET_ID=1

# Create a trade-scoped key at https://app.perpl.xyz/apikeys.
# Never paste these into chat or commit them.
PERPL_API_KEY=
PERPL_API_KEY_SECRET=

# Optional. Auto-discovered from WalletSnapshot after sign-in.
# Set only if your wallet has multiple exchange accounts.
# PERPL_ACCOUNT_ID=

# Keep true until dry-run quote logs look right.
DRY_RUN=false

# Strategy sizing  (start small!)
QUOTE_SIZE=0.01
LEVERAGE_X=15
QUOTE_OFFSET_BPS=0
REQUOTE_INTERVAL_MS=800
MIN_REQUOTE_TICKS=1
MAX_CLOSE_SLIPPAGE_BPS=5
MAX_OPEN_POSITION=0.01
ORDER_LB_OFFSET_BLOCKS=20

# CRITICAL: set true so the bot never leaves inventory open when book is thin.
# False = may pause close attempts and leave position (losses).
ALLOW_EMERGENCY_MARKET_CLOSE=true